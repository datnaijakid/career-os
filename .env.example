# Database URL (Neon PostgreSQL Serverless)
# Use the pooled connection string (with -pooler) for serverless queries:
DATABASE_URL="postgresql://username:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct URL for Prisma schema migrations and prisma db push (direct endpoint without -pooler):
DIRECT_URL="postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for Session & Route Protection (generate a strong random string)
JWT_SECRET="generate-a-strong-random-secret-key-for-jwt-signing"

# OpenAI Configuration (Server-Side Only)
OPENAI_API_KEY="sk-proj-..."
OPENAI_MODEL="gpt-4o-mini"

# EmailJS Configuration (Server-Side Email Dispatch)
EMAILJS_SERVICE_ID="service_..."
EMAILJS_TEMPLATE_ID="template_..."
# Optional dedicated template for password reset (defaults to EMAILJS_TEMPLATE_ID if omitted):
EMAILJS_RESET_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY="mho-..."
EMAILJS_PRIVATE_KEY="Pt0t..."
